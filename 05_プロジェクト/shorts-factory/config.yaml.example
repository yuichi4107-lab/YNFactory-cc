# shorts-factory 設定（~/shorts-factory/config.yaml に置く。無ければ全てデフォルト）
# ここにあるのは変更しそうな項目のみ。全項目は src/config.py の DEFAULTS を参照。

speaker_id: 13               # 青山龍星（ノーマル）。実写版・スライド版の既定を統一。一覧: python -c "from src import tts_voicevox as t; print(t.speaker_names())"
speaker_credit: "VOICEVOX:青山龍星"
speed_scale: 1.0             # 話速（尺超過時は自動で一時的に上がる）

llm:
  provider: claude_cli       # claude_cli | openai（openaiはsecrets.yamlにキー必須）

images:
  provider: card             # card（無料・デザインカード） | openai | gemini（要APIキー）
  count: 4                   # 背景画像の枚数（3〜5推奨）

queue:
  auto_post: false           # ★ true にすると承認スキップで全自動投稿。実公開前に必ず確認
  platforms: [x, youtube, instagram, tiktok]
                              # 投稿先: x / youtube / instagram / tiktok
  retry_failed_posts: true    # 投稿失敗時、失敗媒体だけ自動再投稿する
  retry_max_attempts: 2       # 初回失敗後の自動再投稿回数
  retry_delay_sec: 60         # 再投稿前の待機秒数
  auto_recover_failed_posts: true       # 2回再投稿後も失敗した媒体は自動で原因確認・復旧
  recovery_after_retries: 2             # 何回リトライ後に復旧処理へ進むか
  recovery_retry_attempts: 1            # 復旧後に追加する再投稿回数
  recovery_max_attempts_per_platform: 2 # 同一媒体への復旧処理上限

cta:
  lp_url: "https://ai.yn-factory.com/"
  campaign: "shorts_ai_consult"

content:
  default_difficulty: beginner
  platform_variant_videos: false  # true=SNS別に別動画生成 / false=共通動画1本（Seedance統合後の標準）
  scheduled_slots:
    - {hour: 9, minute: 0, difficulty: beginner}
    - {hour: 14, minute: 0, difficulty: intermediate}
    - {hour: 19, minute: 0, difficulty: intermediate}

topics:
  auto_replenish:
    enabled: true
    min_by_difficulty:
      beginner: 8        # 使用可能ネタがこの数未満なら自動補充
      intermediate: 16
    target_by_difficulty:
      beginner: 18       # 補充後に目指す本数
      intermediate: 36

verify:
  cer_line_max: 0.20         # 行ごとの音韻CER上限
  cer_avg_max: 0.10          # 平均CER上限
  auto_remake_on_fail: true  # 品質検証で不合格なら候補を作り直す
  remake_max_attempts: 2     # 候補生成の最大回数（2=1回作り直し）

# Atlas Cloud Seedance 2.0（Topview運用では false のままにする）
seedance:
  enabled: false                # Topview導入後はAtlas Cloudを呼ばない
  slots: [mon-09, mon-14, mon-19, tue-09, tue-14, tue-19, wed-09, wed-14, wed-19, thu-09, thu-14, thu-19, fri-09, fri-14, fri-19, sat-09, sat-14, sat-19, sun-09, sun-14, sun-19]
  hybrid_slots: [mon-09, mon-14, mon-19, tue-09, tue-14, tue-19, wed-09, wed-14, wed-19, thu-09, thu-14, thu-19, fri-09, fri-14, fri-19, sat-09, sat-14, sat-19, sun-09, sun-14, sun-19]  # 実写→日本語カード→実写→日本語カード。失敗時は従来カード版を作らず停止
  hybrid_lead_in_sec: 0.0      # 冒頭の無音を入れず、最初のフレームから発話
  model: fast                   # std ($0.112/s) | fast ($0.09/s)
  resolution: 720p
  ratio: "9:16"
  audio_mode: voicevox          # voicevox=日本語TTSで差し替え | native=Seedance音声を使う
  generate_audio: false         # 音声はVOICEVOXで差し替え、Seedance音声は使わない
  voicevox_speaker_id: 13       # 青山龍星（ノーマル）
  voicevox_speaker_credit: "VOICEVOX:青山龍星"
  watermark: false
  seed: 42                      # 固定するとカット間のスタイル一貫性が上がる
  cut_duration_sec: 10
  poll_interval_sec: 15
  timeout_sec: 1800             # 1カットあたりのポーリングタイムアウト（秒）
  monthly_budget_usd: 130.0     # 月間上限。超過時は混在版の候補を作らず停止
  max_cost_per_video_usd: 10.0  # 1本あたりの上限（異常値の暴走防止）
  cer_line_max: 0.30            # native音声時の許容値。voicevox時は通常verify閾値を使う
  cer_avg_max: 0.18
  remake_max_attempts: 1        # CER不合格時の再生成は1回のみ。それでも不合格なら停止

# Topviewで手動書き出しした実写素材を使う混在形式。
# この設定や登録スクリプトはTopviewの生成/API/課金を一切実行しない。
# assets_dir に書き出しmp4を置き、以下で検証・登録する:
#   python scripts/register_topview_assets.py <file1.mp4> <file2.mp4> ...
topview:
  enabled: true
  slots: [mon-09, mon-14, mon-19, tue-09, tue-14, tue-19, wed-09, wed-14, wed-19, thu-09, thu-14, thu-19, fri-09, fri-14, fri-19, sat-09, sat-14, sat-19, sun-09, sun-14, sun-19]
  assets_dir: "~/shorts-factory/topview_assets"
  manifest: "~/shorts-factory/topview_assets/manifest.json"
  min_enabled_clips: 6          # 不足時は旧カード版を作らず安全停止
  low_stock_warn_clips: 6       # 未使用がこの本数以下になったら生成後に補充を通知
  min_clip_duration_sec: 3.0
  voicevox_speaker_id: 13       # 40代男性の青山龍星（ノーマル）
  voicevox_speaker_credit: "VOICEVOX:青山龍星"
