# shorts-factory 設定（~/shorts-factory/config.yaml に置く。無ければ全てデフォルト）
# ここにあるのは変更しそうな項目のみ。全項目は src/config.py の DEFAULTS を参照。

speaker_id: 3                # VOICEVOX話者ID（3=ずんだもんノーマル。一覧: python -c "from src import tts_voicevox as t; print(t.speaker_names())"）
speaker_credit: "VOICEVOX:ずんだもん"
speed_scale: 1.0             # 話速（尺超過時は自動で一時的に上がる）

llm:
  provider: claude_cli       # claude_cli | openai（openaiはsecrets.yamlにキー必須）

images:
  provider: card             # card（無料・デザインカード） | openai | gemini（要APIキー）
  count: 4                   # 背景画像の枚数（3〜5推奨）

queue:
  auto_post: false           # ★ true にすると承認スキップで全自動投稿。実公開前に必ず確認
  platforms: [x, youtube, instagram, tiktok]
                              # 投稿先: x / youtube / instagram / tiktok
  retry_failed_posts: true    # 投稿失敗時、失敗媒体だけ自動再投稿する
  retry_max_attempts: 2       # 初回失敗後の自動再投稿回数
  retry_delay_sec: 60         # 再投稿前の待機秒数
  auto_recover_failed_posts: true       # 2回再投稿後も失敗した媒体は自動で原因確認・復旧
  recovery_after_retries: 2             # 何回リトライ後に復旧処理へ進むか
  recovery_retry_attempts: 1            # 復旧後に追加する再投稿回数
  recovery_max_attempts_per_platform: 2 # 同一媒体への復旧処理上限

cta:
  lp_url: "https://ai.yn-factory.com/"
  campaign: "shorts_ai_consult"

content:
  default_difficulty: beginner
  scheduled_slots:
    - {hour: 9, minute: 0, difficulty: beginner}
    - {hour: 14, minute: 0, difficulty: intermediate}
    - {hour: 19, minute: 0, difficulty: intermediate}

verify:
  cer_line_max: 0.20         # 行ごとの音韻CER上限
  cer_avg_max: 0.10          # 平均CER上限
