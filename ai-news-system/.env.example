# ===========================================
# AIニュース配信システム 環境変数設定
# ===========================================
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# --- 必須 ---
# X API (Twitter API v2) Bearer Token
TWITTER_BEARER_TOKEN=xxxxxxxxxxxx

# --- 任意 ---
# LINE Messaging API（配信に使用）
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxx
LINE_USER_ID=Uxxxxxxxxxxxx

# Google Docs アーカイブ（GAS Webアプリ経由）
GAS_WEBAPP_URL=https://script.google.com/macros/s/xxxxxxxxxxxx/exec
GAS_AUTH_TOKEN=your-random-secret-token-here

# ※ 要約・翻訳は Claude Code CLI を使用するためAPIキー不要
